<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        tools:context=".ui.HomeActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

    <Button
            android:id="@+id/effect_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="效果对比"
            android:layout_margin="32dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <Button
            android:id="@+id/profile_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="性能测试"
            android:layout_margin="32dp"
            app:layout_constraintTop_toBottomOf="@id/effect_activity"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <Button
            android:id="@+id/yuv_activity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="导出处理结果yuv"
            android:layout_margin="32dp"
            app:layout_constraintTop_toBottomOf="@id/profile_activity"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    <TextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_margin="32dp"
            app:layout_constraintTop_toBottomOf="@id/yuv_activity"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
            tensor<int32, []> input_43_groups_0 = const()[name = tensor<string, []>("input_43_groups_0"), val = tensor<int32, []>(1)];
            tensor<fp16, [4, 16, 3, 3]> quickcnn_conv_last_weight_to_fp16 = const()[name = tensor<string, []>("quickcnn_conv_last_weight_to_fp16"), val = tensor<fp16, [4, 16, 3, 3]>(BLOBFILE(path = tensor<string, []>("@model_path/weights/weight.bin"), offset = tensor<uint64, []>(28160)))];
            tensor<fp16, [4]> quickcnn_conv_last_bias_to_fp16 = const()[name = tensor<string, []>("quickcnn_conv_last_bias_to_fp16"), val = tensor<fp16, [4]>([0x1.b9cp-8, 0x1.9bp-8, 0x1.c0cp-8, 0x1.088p-7])];
            tensor<fp16, [1, 4, ?, ?]> input_43_cast_fp16 = conv(bias = quickcnn_conv_last_bias_to_fp16, dilations = input_43_dilations_0, groups = input_43_groups_0, pad = input_43_pad_0, pad_type = input_43_pad_type_0, strides = input_43_strides_0, weight = quickcnn_conv_last_weight_to_fp16, x = input_41_cast_fp16)[name = tensor<string, []>("input_43_cast_fp16")];
            tensor<fp16, []> input_alpha_0_to_fp16 = const()[name = tensor<string, []>("input_alpha_0_to_fp16"), val = tensor<fp16, []>(0x0p+0)];
            tensor<fp16, []> input_beta_0_to_fp16 = const()[name = tensor<string, []>("input_beta_0_to_fp16"), val = tensor<fp16, []>(0x1p+0)];
            tensor<fp16, [1, 4, ?, ?]> input_cast_fp16 = clip(alpha = input_alpha_0_to_fp16, beta = input_beta_0_to_fp16, x = input_43_cast_fp16)[name = tensor<string, []>("input_cast_fp16")];
            tensor<fp16, [1, 1, ?, ?]> eh_out_cast_fp16 = pixel_shuffle(upscale_factor = var_65, x = input_cast_fp16)[name = tensor<string, []>("eh_out_cast_fp16")];
            tensor<fp16, []> var_114_to_fp16 = const()[name = tensor<string, []>("op_114_to_fp16"), val = tensor<fp16, []>(0x1.fep+7)];
            tensor<fp16, [1, 1, ?, ?]> output_image = mul(x = eh_out_cast_fp16, y = var_114_to_fp16)[name = tensor<string, []>("op_115_cast_fp16")];
        } -> (output_image);
}